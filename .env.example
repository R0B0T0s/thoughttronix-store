# Copy to .env to override defaults. The app runs fine with no .env at all.
# SECRET_KEY=generate-a-real-one-for-anything-beyond-a-laptop
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1

# Email. With no EMAIL_HOST, emails print to the terminal. Set EMAIL_HOST to
# send real mail over SMTP; keep the credentials here, never in source.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=store@example.com
# EMAIL_HOST_PASSWORD=your-mail-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=The ThoughtTronix Store <no-reply@thoughttronix.example>
